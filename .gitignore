# Environment secrets — NEVER commit these
.env
.env.local
.env.production

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
/dist/
/build/

# Database files — keep local only
*.db
*.sqlite
*.sqlite3

# Generated reports
*.docx

# Node
node_modules/
frontend/node_modules/
# frontend/dist/ intentionally tracked so Render serves pre-built assets

# Temp files
*.log
logs/
backups/
.DS_Store
Thumbs.db

# Tool caches / editors
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/

.vercel
.env*.local

# Vector Database
chroma_db*/
test_chroma_db/
.venv/
my_venv/
venv_313/
*.venv/


# Scratch/debug files
scratch/
outputs/
startup_*.txt
frontend/studio-verification.png
hermes_skills_library/
# But the runtime petroleum skill scripts (executed by skills_engine.py) MUST stay tracked.
# Git will not descend into an ignored DIRECTORY, so re-including files inside it requires
# first un-ignoring the directory itself, then re-including its contents. Walk the tree down:
!hermes_skills_library/
hermes_skills_library/*
!hermes_skills_library/petroleum/
!hermes_skills_library/petroleum/**
# Keep compiled bytecode out regardless of the negations above.
hermes_skills_library/**/__pycache__/
test_centrifuge.xlsx
pytest_temp/
temp_pytest/

# Generated SCAL spreadsheet artifacts
PRC_XLSX_*

# Genkit dev/reflection server runtime logs & traces (not source)
.genkit/

# Editor / migration backup files
*.bak
*.original.bak

# Generated reports and local uploads
uploads/
vault_backups/
test_generated/
reports/
# report/deck export directory (PRC_AI_VAULT default)
vault/
