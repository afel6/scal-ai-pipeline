# SCAL AI Pipeline Configuration Template
# Copy this file to .env and fill in the values

# === Core API Keys ===
GEMINI_API_KEY=AIzaSyDUMMYKEY1,AIzaSyDUMMYKEY2

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/db
DB_DIR=.

# === Vault / Exports ===
PRC_AI_VAULT=C:/Users/Asus/Downloads/PRC_AI_Vault

# === CORS Origins ===
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Security ===
ADMIN_PIN=change_this_to_secure_pin
KB_INGEST_SECRET=change_this_to_secure_secret

# === Upload Limits ===
SCAL_MAX_UPLOAD_MB=75

# === Runtime Mode ===
TESTING=False
DEBUG=False
PYTHON_EXE=python

# === ChromaDB ===
CHROMA_DIR=./chroma_db

# === Rate Limiting (optional Redis backend) ===
REDIS_URL=

# === Alerting: SMTP ===
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=

# === Alerting: Webhook (Slack/Teams) ===
ALERT_WEBHOOK_URL=
