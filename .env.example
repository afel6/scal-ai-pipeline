# SCAL AI Pipeline Configuration Template
# Copy this file to .env and fill in the values

# === Chat LLM (single provider-neutral adapter — llm_adapter.py) ===
# Every chat call routes through the adapter. Provider + model come from here,
# never from code; the model reported anywhere is the model actually used.
#   LLM_PROVIDER   mock | ollama | nvidia | gemini | openai   (default mock)
#   LLM_MODEL      model id sent on the wire           (default per provider)
#   LLM_BASE_URL   OpenAI-compatible chat/completions URL (default per provider)
#   LLM_API_KEYS   comma-separated key pool (LLM_API_KEY for a single key)
#   LLM_HTTP_TIMEOUT seconds (default 300)
# D0 air-gap: a real provider is an explicit opt-in — only LLM_PROVIDER selects
# one; a URL, model or key on its own never does. A cloud provider (nvidia |
# gemini | openai), or a real GEMINI_API_KEY, configured while DATABASE_URL is
# reachable is a startup HARD-FAIL: private data must not leave the machine.
# Legacy names still supply URL/model/keys: SCAL_LLM_BASE_URL, SCAL_LLM_MODEL,
# NVIDIA_API_KEY*.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEYS=

# === Embeddings (Gemini — quarantined until the local embedding migration) ===
# Leave blank for air-gapped operation: embeddings are then disabled (KB vector
# search returns no hits) and startup does not call the provider.
GEMINI_API_KEY=

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/db
DB_DIR=.

# === Vault / Exports ===
PRC_AI_VAULT=vault

# === CORS Origins ===
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Security ===
ADMIN_PIN=change_this_to_secure_pin
# USER_PIN must DIFFER from ADMIN_PIN; if unset it falls back to ADMIN_PIN
# (a startup warning fires) and every user shares the admin credential.
USER_PIN=change_this_to_a_different_pin
KB_INGEST_SECRET=change_this_to_secure_secret

# === Docker Compose (docker-compose.yaml) — required, no built-in defaults ===
# `docker compose up` fails fast if the password/key vars below are unset.
DB_POSTGRES_USER=prc_user
DB_POSTGRES_PASSWORD=change_this_strong_password
DB_POSTGRES_DATABASE=prc_hub
N8N_ENCRYPTION_KEY=change_this_random_hex
KB_INGEST_PASSWORD=change_this_to_secure_secret

# === Upload Limits ===
SCAL_MAX_UPLOAD_MB=75

# === Runtime Mode ===
TESTING=False
DEBUG=False
PYTHON_EXE=python
# Directory for rotating file logs (app.log, 10MB x5). Default ./logs.
LOG_DIR=./logs
# Set to 1 to allow the SQLite fallback when DATABASE_URL is set but Postgres
# is unreachable (local dev only). Unset = fail loud instead of splitting data.
ALLOW_SQLITE_FALLBACK=

# === ChromaDB ===
CHROMA_DIR=./chroma_db

# === Rate Limiting (optional Redis backend) ===
REDIS_URL=

# === Alerting: SMTP ===
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=

# === Alerting: Webhook (Slack/Teams) ===
ALERT_WEBHOOK_URL=
